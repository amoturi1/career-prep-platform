# Copy this file to .env and change the values before deploying.
# SQLite is used for local development. For PostgreSQL use, for example:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/careerprep
DATABASE_URL=sqlite:///./careerprep.db
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_MINUTES=60
CORS_ORIGINS=http://localhost:5173

# ---- AI (optional) ----
# Without a key, the built-in engine handles resume matching and interview feedback.
# Add a Claude API key from https://console.anthropic.com to use Claude instead.
# AI_PROVIDER: auto (Claude if a key is set), local (always built-in), or claude
AI_PROVIDER=auto
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5

# Resume uploads
MAX_RESUME_MB=2
